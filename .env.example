# =============================================================================
# ChildShield Climate AI — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

APP_NAME="ChildShield Climate AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Maputo

# Encryption key for phone numbers (use a separate key from APP_KEY)
PHONE_ENCRYPTION_KEY=

#  Database (PostgreSQL + PostGIS)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=childshield
DB_USERNAME=postgres
DB_PASSWORD=secret

#  Cache / Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#  JWT
JWT_SECRET=
JWT_TTL=60               # minutes
JWT_REFRESH_TTL=20160    # 2 weeks

#  Africa's Talking (USSD + SMS)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=ChildShield
AT_USSD_CODE=*123#

#  WhatsApp
WA_DRIVER=baileys                  # baileys (dev) | waba (prod)
WA_BAILEYS_URL=http://localhost:3000
WA_WABA_URL=https://waba.360dialog.io/v1
WA_WABA_TOKEN=

#  Climate APIs
OPENWEATHER_API_KEY=
TOMORROW_API_KEY=

#  OpenAI (message generation)
OPENAI_API_KEY=

#  Scramble API docs
SCRAMBLE_API_DOMAIN=localhost
SCRAMBLE_API_PATH=api

#  Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@childshield.mz"
MAIL_FROM_NAME="${APP_NAME}"

#  Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

#  Admin seeder defaults (CHANGE IN PRODUCTION)
ADMIN_EMAIL=admin@childshield.mz
ADMIN_PASSWORD=ChildShield@2025!
